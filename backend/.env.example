# Copiază acest fișier în .env și schimbă valorile. .env NU se pune în Git.
DATABASE_URL=postgresql+psycopg://mana:mana@localhost:5432/mana_in_mana
# O valoare lungă și aleatorie, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=schimba-ma
# Aceeași valoare se pune pe Raspberry Pi în variabila ROBOT_API_KEY
ROBOT_API_KEY=schimba-si-cheia-robotului
