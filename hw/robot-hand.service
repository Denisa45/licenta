# Pornește command_listener.py la boot și îl repornește dacă se oprește.
#
# Instalare pe Pi (o singură dată). Dacă utilizatorul nu e "pi" sau repo-ul
# nu e în ~/Desktop/licenta, schimbă User, WorkingDirectory și Environment mai jos.
#   sudo cp hw/robot-hand.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now robot-hand
#
# Verificare:  systemctl status robot-hand
# Log live:    journalctl -u robot-hand -f
# Oprire:      sudo systemctl stop robot-hand   (ex. înainte de test_fingers.py)
#
# Dacă pachetele sunt într-un venv, pune în ExecStart python-ul din venv,
# ex. /home/pi/Desktop/licenta/.venv/bin/python.

[Unit]
Description=Mana robotica - preia comenzi de la server
Wants=network-online.target
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Desktop/licenta/hw
# Adresa serverului (calculatorul pe care rulează backend/) și cheia robotului,
# aceeași ca ROBOT_API_KEY din backend/.env
Environment=SERVER_URL=http://192.168.1.10:8000
Environment=ROBOT_API_KEY=schimba-si-cheia-robotului
Environment=ROBOT_HOLD=5
Environment=ROBOT_LETTER_HOLD=2
ExecStart=/usr/bin/python3 -u command_listener.py
# dacă programul se oprește, încearcă din nou după 5 s
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
